# Copy to .env and fill in secrets. Never commit .env.

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=256
GROQ_TEMPERATURE=0.6
HISTORY_TURNS=6

# --- Audio I/O ---
SAMPLE_RATE=16000
CHANNELS=1
FRAME_MS=30
INPUT_DEVICE=
OUTPUT_DEVICE=

# --- Wake word (openWakeWord) ---
# Built-in model name (e.g. hey_jarvis) or path to a custom .onnx
WAKE_MODEL=hey_jarvis
WAKE_THRESHOLD=0.5
WAKE_INFERENCE_FRAMEWORK=onnx

# --- VAD (Silero ONNX) ---
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=400
VAD_SPEECH_PAD_MS=100
# Optional local path; if empty, downloaded/cached on first use
VAD_MODEL_PATH=

# --- STT (faster-whisper) ---
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1

# --- TTS (Piper) ---
# Path to Piper voice .onnx (download en_US-lessac-medium separately)
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
PIPER_SPEAKER_ID=0
PIPER_LENGTH_SCALE=1.0

# --- Memory (profile + notes) ---
PROFILE_PATH=data/profile.yaml
NOTES_DIR=data/notes

# --- Tools / confirm gate ---
# External send tools (email, WhatsApp, etc.) require spoken confirmation
REQUIRE_SEND_CONFIRM=true

# --- Google (OAuth for Calendar + Gmail) ---
# Create at https://console.cloud.google.com/ — enable Calendar + Gmail APIs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_TOKEN_PATH=data/google_token.json

# --- Meta (WhatsApp Cloud API + Instagram Graph API) ---
# Create at https://developers.facebook.com/ — WhatsApp Business API + Instagram Graph API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_IG_TOKEN=
META_IG_USER_ID=

# --- LinkedIn ---
# Create at https://www.linkedin.com/developers/ — LinkedIn Marketing API
LINKEDIN_ACCESS_TOKEN=

# --- Pipeline queues ---
AUDIO_QUEUE_SIZE=64
TOKEN_QUEUE_SIZE=256
TTS_SENTENCE_QUEUE_SIZE=8
PLAYBACK_QUEUE_SIZE=32

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
LOG_DIR=logs
DEBUG_STATE_MACHINE=false

# Barge-in: wake word always works.
# VAD barge-in is OFF by default — speaker echo was cutting replies mid-sentence.
# Enable only with headphones / AEC: BARGE_IN_ON_VAD=true
BARGE_IN_ON_VAD=false
BARGE_IN_VAD_THRESHOLD=0.9
BARGE_IN_GRACE_MS=1500
