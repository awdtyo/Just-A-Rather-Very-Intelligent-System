# Copy to .env and fill in secrets. Never commit .env.

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=256
GROQ_TEMPERATURE=0.6
HISTORY_TURNS=6

# --- Audio I/O ---
SAMPLE_RATE=16000
CHANNELS=1
FRAME_MS=30
INPUT_DEVICE=
OUTPUT_DEVICE=

# --- Wake word (openWakeWord) ---
# Built-in model name (e.g. hey_jarvis) or path to a custom .onnx
WAKE_MODEL=hey_jarvis
WAKE_THRESHOLD=0.5
WAKE_INFERENCE_FRAMEWORK=onnx

# --- VAD (Silero ONNX) ---
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=400
VAD_SPEECH_PAD_MS=100
# Optional local path; if empty, downloaded/cached on first use
VAD_MODEL_PATH=

# --- STT (faster-whisper) ---
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1

# --- TTS (Piper) ---
# Path to Piper voice .onnx (download en_US-lessac-medium separately)
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
PIPER_SPEAKER_ID=0
PIPER_LENGTH_SCALE=1.0

# --- Pipeline queues ---
AUDIO_QUEUE_SIZE=64
TOKEN_QUEUE_SIZE=256
TTS_SENTENCE_QUEUE_SIZE=8
PLAYBACK_QUEUE_SIZE=32

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
LOG_DIR=logs
DEBUG_STATE_MACHINE=false

# Barge-in: interrupt on wake word always; also on loud VAD speech while speaking
# (raise threshold / use headphones if speaker echo false-triggers)
BARGE_IN_ON_VAD=true
BARGE_IN_VAD_THRESHOLD=0.85
BARGE_IN_GRACE_MS=500
